<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <FrameLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_liquid"
        tools:context=".MainActivity">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroller"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter">

                    <!-- ================= Header ================= -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="16dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.14"
                                android:text="@string/live_throughput"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/title_dashboard"
                                android:textColor="@color/text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/languageButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/glass_chip"
                            android:clickable="true"
                            android:contentDescription="@string/language"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_language" />

                        <LinearLayout
                            android:id="@+id/connectionChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="7dp">

                            <ImageView
                                android:id="@+id/connectionIcon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wifi" />

                            <TextView
                                android:id="@+id/connectionLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:maxLines="1"
                                android:text="@string/wifi"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ================= Hero gauge ================= -->
                    <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="18dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp"
                        app:glassAlpha="0.17"
                        app:glassCornerRadius="@dimen/glass_radius"
                        app:glassGlow="@color/accent_cyan">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <dev.jahidhasanco.datausage.presentation.view.LiquidGaugeView
                                android:id="@+id/speedGauge"
                                android:layout_width="match_parent"
                                android:layout_height="208dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/statDown"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/statUp"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/statTodayMobile"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/statTodayWifi"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1" />
                            </LinearLayout>
                        </LinearLayout>
                    </dev.jahidhasanco.datausage.presentation.view.GlassCardView>

                    <!-- ================= Hourly chart ================= -->
                    <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:padding="18dp"
                        app:glassCornerRadius="@dimen/glass_radius"
                        app:glassGlow="@color/accent_violet">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/hourlyHeader"
                                layout="@layout/part_section_header" />

                            <dev.jahidhasanco.datausage.presentation.view.GlassBarChartView
                                android:id="@+id/hourlyChart"
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:layout_marginTop="16dp" />
                        </LinearLayout>
                    </dev.jahidhasanco.datausage.presentation.view.GlassCardView>

                    <!-- ================= Range selector ================= -->
                    <LinearLayout
                        android:id="@+id/rangeTrack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:background="@drawable/glass_pill_track"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/range7"
                            style="@style/GlassRangePill"
                            android:text="@string/range_7" />

                        <TextView
                            android:id="@+id/range30"
                            style="@style/GlassRangePill"
                            android:text="@string/range_30" />

                        <TextView
                            android:id="@+id/range60"
                            style="@style/GlassRangePill"
                            android:text="@string/range_60" />

                        <TextView
                            android:id="@+id/range90"
                            style="@style/GlassRangePill"
                            android:text="@string/range_90" />
                    </LinearLayout>

                    <!-- ================= Summary ================= -->
                    <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:padding="18dp"
                        app:glassCornerRadius="@dimen/glass_radius"
                        app:glassGlow="@color/accent_mint">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/summaryHeader"
                                layout="@layout/part_section_header" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/statTotal"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/statAverage"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/statPeak"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/statProjection"
                                    layout="@layout/part_metric_tile"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/splitMobile"
                                    layout="@layout/part_split_row"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/splitWifi"
                                    layout="@layout/part_split_row"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </dev.jahidhasanco.datausage.presentation.view.GlassCardView>

                    <!-- ================= Top apps ================= -->
                    <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="10dp"
                        app:glassCornerRadius="@dimen/glass_radius"
                        app:glassGlow="@color/accent_coral">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/appsHeader"
                                layout="@layout/part_section_header" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/appUsageRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                tools:listitem="@layout/item_app_usage" />

                            <TextView
                                android:id="@+id/appsEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="18dp"
                                android:paddingBottom="18dp"
                                android:gravity="center"
                                android:text="@string/no_apps"
                                android:textColor="@color/text_tertiary"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </dev.jahidhasanco.datausage.presentation.view.GlassCardView>

                    <!-- ================= Daily breakdown ================= -->
                    <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="10dp"
                        app:glassCornerRadius="@dimen/glass_radius"
                        app:glassGlow="@color/accent_cyan">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/breakdownHeader"
                                layout="@layout/part_section_header" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/GlassCaption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:text="@string/date" />

                                <TextView
                                    style="@style/GlassCaption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:text="@string/mobile" />

                                <TextView
                                    style="@style/GlassCaption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:text="@string/wifi" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/monthlyDataUsagesRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                tools:listitem="@layout/item_daily_usages" />
                        </LinearLayout>
                    </dev.jahidhasanco.datausage.presentation.view.GlassCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- ================= Permission gate ================= -->
        <FrameLayout
            android:id="@+id/permissionGate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3050817"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <dev.jahidhasanco.datausage.presentation.view.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="26dp"
                android:padding="24dp"
                app:glassAlpha="0.2"
                app:glassCornerRadius="@dimen/glass_radius"
                app:glassGlow="@color/accent_violet">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chart" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/permission_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/permission_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/permissionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/glass_pill_active"
                        android:paddingStart="26dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="12dp"
                        android:text="@string/permission_action"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </dev.jahidhasanco.datausage.presentation.view.GlassCardView>
        </FrameLayout>

    </FrameLayout>
</layout>
