<?xml version="1.0" encoding="utf-8"?>
<!-- Small stat tile used across the hero and summary cards. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_small"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tileIcon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download" />

            <TextView
                android:id="@+id/tileLabel"
                style="@style/GlassCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Download" />
        </LinearLayout>

        <TextView
            android:id="@+id/tileValue"
            style="@style/GlassStatValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            tools:text="1.24 GB" />

        <TextView
            android:id="@+id/tileHint"
            style="@style/GlassCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="+12% vs previous"
            tools:visibility="visible" />
    </LinearLayout>
</layout>
